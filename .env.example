# Application Settings
APP_NAME="BugBountyHunterBot"
APP_ENV="development"
DEBUG=true
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite by default for local development, or PostgreSQL)
DATABASE_URL="sqlite:///./bug_bounty_bot.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/bug_bounty_db"

# SMTP Email Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=scanner-alerts@yourdomain.com
ALERT_TO_EMAIL=bounty-researcher@yourdomain.com
SMTP_USE_TLS=true
EMAIL_NOTIFICATIONS_ENABLED=false

# Scanner Global Limits & Safeguards
MAX_CONCURRENT_SCANS=3
DEFAULT_RATE_LIMIT_RPS=2.0
SCAN_TIMEOUT_SECONDS=30
GLOBAL_EMERGENCY_STOP=false

# Security & SSRF Safeguards
BLOCK_PRIVATE_NETWORKS=true
BLOCK_CLOUD_METADATA=true
DEFAULT_ALLOWLIST_MODE="STRICT"
